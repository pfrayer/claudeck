{
  "permissions": {
    "allow": [
      "Bash(./src/claudeck --port *)",
      "Bash(curl -s localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(python3 -m py_compile *)",
      "Bash(node --check *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-syntax.sh",
            "timeout": 30,
            "statusMessage": "Checking syntax…"
          }
        ]
      }
    ]
  }
}
