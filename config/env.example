# Copied to ~/.config/claudeck/env by scripts/install.sh
CLAUDECK_PORT=8765
# Remote access behind a reverse proxy (see README). A non-loopback bind requires a token;
# set a fixed one, otherwise a new token is generated on every restart. chmod 600 this file.
#CLAUDECK_BIND=0.0.0.0
# Token: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#CLAUDECK_TOKEN=
#CLAUDECK_ALLOWED_HOSTS=devserver.example.com
