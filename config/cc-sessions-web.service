[Unit]
Description=cc-sessions-web: local web view of Claude Code sessions
Documentation=file://%h/workspace/github/cc-sessions-web

[Service]
Type=simple
# Port: override CC_SESSIONS_WEB_PORT in ~/.config/cc-sessions-web/env
Environment=CC_SESSIONS_WEB_PORT=8765
EnvironmentFile=-%h/.config/cc-sessions-web/env
ExecStart=%h/bin/cc-sessions-web --no-browser
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
