#!/usr/bin/env python3
"""claudeck — local web view of Claude Code sessions, grouped by folder.

Read-only on ~/.claude/projects. Listens on 127.0.0.1 by default.
Usage: claudeck [--port PORT] [--bind ADDR] [--allowed-host H[,H]] [--token T] [--no-browser]
Port: --port, else $CLAUDECK_PORT, else 8765.
Binding a non-loopback address (e.g. `claudeck --bind 0.0.0.0` behind a reverse proxy)
requires a token: --token / $CLAUDECK_TOKEN, else a random one. Ready-to-open URLs are
printed at startup; /?token=<T> sets a cookie, or send "Authorization: Bearer <T>".
Without --allowed-host any Host header is accepted in that mode (the token guards access).
"""
import argparse
import hmac
import ipaddress
import json
import os
import re
import secrets
import socket
import threading
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PROJECTS = Path.home() / ".claude" / "projects"
HOME = str(Path.home())
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")

_cache: dict[str, tuple[float, dict]] = {}  # path -> (mtime, meta)
_lock = threading.Lock()


def _text_of(content, with_tools=False):
    """Extract the text of a message (str or list of content blocks)."""
    if isinstance(content, str):
        return content
    parts = []
    for b in content or []:
        if not isinstance(b, dict):
            continue
        if b.get("type") == "text":
            parts.append(b.get("text", ""))
        elif with_tools and b.get("type") == "tool_use":
            inp = b.get("input") or {}
            hint = inp.get("description") or inp.get("command") or inp.get("file_path") or ""
            parts.append(f"→ {b.get('name')} {str(hint)[:120]}".rstrip())
    return "\n".join(p for p in parts if p)


def _is_noise(text):
    t = text.lstrip()
    return not t or t.startswith(("<command-", "<local-command", "<system-reminder", "Caveat:"))


def _iter_lines(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            try:
                yield json.loads(line)
            except ValueError:
                continue


def scan_file(path: Path):
    meta = {"id": path.stem, "cwd": None, "title": None, "first": None,
            "branch": None, "prompts": "", "user": 0, "assistant": 0, "start": None, "end": None}
    for d in _iter_lines(path):
        t = d.get("type")
        if t == "ai-title" and d.get("aiTitle"):
            meta["title"] = d["aiTitle"]
        elif t == "summary" and d.get("summary") and not meta["title"]:
            meta["title"] = d["summary"]
        if t not in ("user", "assistant") or d.get("isSidechain"):
            continue
        meta["cwd"] = meta["cwd"] or d.get("cwd")
        meta["branch"] = d.get("gitBranch") or meta["branch"]
        ts = d.get("timestamp")
        if ts:
            meta["start"] = meta["start"] or ts
            meta["end"] = ts
        if t == "user":
            text = _text_of((d.get("message") or {}).get("content"))
            if d.get("isMeta") or _is_noise(text):
                continue
            meta["user"] += 1
            if not meta["first"]:
                meta["first"] = text.strip()[:200]
            if len(meta["prompts"]) < 4000:
                meta["prompts"] += " " + text.strip()[:1000]
        else:
            meta["assistant"] += 1
    return meta


def all_sessions():
    out = []
    for path in PROJECTS.glob("*/*.jsonl"):
        if not UUID_RE.match(path.stem):
            continue
        try:
            st = path.stat()
        except OSError:
            continue
        with _lock:
            hit = _cache.get(str(path))
        if hit and hit[0] == st.st_mtime:
            meta = hit[1]
        else:
            meta = scan_file(path)
            meta["size"] = st.st_size
            meta["mtime"] = st.st_mtime
            with _lock:
                _cache[str(path)] = (st.st_mtime, meta)
        if meta["user"] == 0:
            continue  # empty session (started then quit)
        if not meta["cwd"]:
            meta["cwd"] = "?" + path.parent.name
        out.append(meta)
    out.sort(key=lambda m: m["mtime"], reverse=True)
    return out


MAX_MSG_CHARS = 4000


def _clip(text):
    """Truncate a message, closing an open code fence and saying how much was cut."""
    if len(text) <= MAX_MSG_CHARS:
        return text
    head = text[:MAX_MSG_CHARS]
    if head.count("```") % 2:
        head += "\n```"
    return f"{head}\n\n[… {len(text) - MAX_MSG_CHARS:,} more characters not shown]"


def transcript(sid):
    paths = list(PROJECTS.glob(f"*/{sid}.jsonl"))
    if not paths:
        return None
    msgs = []
    for d in _iter_lines(paths[0]):
        t = d.get("type")
        if t not in ("user", "assistant") or d.get("isSidechain") or d.get("isMeta"):
            continue
        text = _text_of((d.get("message") or {}).get("content"), with_tools=(t == "assistant"))
        if _is_noise(text):
            continue
        msgs.append({"role": t, "text": _clip(text), "ts": d.get("timestamp")})
    return msgs


class Handler(BaseHTTPRequestHandler):
    server_version = "claudeck"

    def log_message(self, *a):
        pass

    def _host_ok(self):
        # DNS rebinding protection: only localhost and the --allowed-host names are accepted.
        # ALLOWED_HOSTS is None when exposed without --allowed-host: any Host is accepted and the
        # token alone guards access (a rebinding origin never holds the cookie).
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0].lower()
        return ALLOWED_HOSTS is None or host in ALLOWED_HOSTS

    def _token_ok(self):
        if TOKEN is None:
            return True
        auth = self.headers.get("Authorization") or ""
        if auth.startswith("Bearer ") and hmac.compare_digest(auth[7:].encode(), TOKEN.encode()):
            return True
        for part in (self.headers.get("Cookie") or "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == COOKIE and hmac.compare_digest(v.encode(), TOKEN.encode()):
                return True
        return False

    def _login(self, query):
        """/?token=<T>: set the auth cookie and redirect to / (drops the token from the URL)."""
        given = next((v for k, _, v in (q.partition("=") for q in query.split("&")) if k == "token"), "")
        if TOKEN is None or not hmac.compare_digest(given.encode(), TOKEN.encode()):
            return False
        secure = "; Secure" if self.headers.get("X-Forwarded-Proto") == "https" else ""
        self.send_response(303)
        self.send_header("Location", "./")
        self.send_header("Set-Cookie", f"{COOKIE}={TOKEN}; Path=/; HttpOnly; SameSite=Lax; Max-Age=31536000{secure}")
        self.send_header("Content-Length", "0")
        self.end_headers()
        return True

    def _send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else (
            json.dumps(body).encode() if ctype == "application/json" else body.encode())
        self.send_response(code)
        self.send_header("Content-Type", ctype + "; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if not self._host_ok():
            return self._send(403, {"error": "host"})
        p, _, query = self.path.partition("?")
        if p == "/" and "token=" in query and self._login(query):
            return
        if not self._token_ok():
            return self._send(401, {"error": "token required: open /?token=<TOKEN>"})
        if p == "/":
            return self._send(200, PAGE_FILE.read_bytes(), "text/html")
        if p == "/api/sessions":
            return self._send(200, {"home": HOME, "sessions": all_sessions()})
        m = re.match(r"^/api/session/([0-9a-f-]{36})$", p)
        if m and UUID_RE.match(m[1]):
            msgs = transcript(m[1])
            return self._send(200, msgs) if msgs is not None else self._send(404, {"error": "not found"})
        self._send(404, {"error": "not found"})



# The page is served from the sibling file, re-read on every request (editable without restart).
PAGE_FILE = Path(__file__).resolve().with_name("claudeck.html")


DEFAULT_PORT = 8765
COOKIE = "claudeck_token"
ALLOWED_HOSTS = {"127.0.0.1", "localhost"}
TOKEN = None  # set in main() when binding a non-loopback address


def port_arg(value):
    try:
        port = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"invalid port: {value!r}")
    if not 1024 <= port <= 65535:
        raise argparse.ArgumentTypeError(f"port out of range 1024-65535: {port}")
    return port


def bind_arg(value):
    try:
        return str(ipaddress.IPv4Address(value))
    except ValueError:
        raise argparse.ArgumentTypeError(f"invalid IPv4 address: {value!r}")


def hosts_arg(value):
    hosts = {h.strip().lower() for h in value.split(",") if h.strip()}
    for h in hosts:
        if not re.fullmatch(r"[a-z0-9.-]+", h):
            raise argparse.ArgumentTypeError(f"invalid host name: {h!r}")
    return hosts


def _public_names(bind):
    """Best-effort names/addresses to reach this host, for the startup banner (no traffic sent)."""
    names = [] if bind == "0.0.0.0" else [bind]
    if not names:
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
                s.connect(("192.0.2.1", 9))  # UDP connect: picks the outbound interface, sends nothing
                names.append(s.getsockname()[0])
        except OSError:
            pass
    fqdn = socket.getfqdn()
    if fqdn and fqdn not in ("localhost", "localhost.localdomain"):
        names.insert(0, fqdn)
    return names


def main():
    global TOKEN, ALLOWED_HOSTS
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--port", type=port_arg,
                    default=os.environ.get("CLAUDECK_PORT", DEFAULT_PORT),
                    help=f"HTTP port (default: $CLAUDECK_PORT or {DEFAULT_PORT})")
    ap.add_argument("--bind", type=bind_arg, default=os.environ.get("CLAUDECK_BIND", "127.0.0.1"),
                    help="IPv4 address to listen on (default: $CLAUDECK_BIND or 127.0.0.1); "
                         "a non-loopback address requires a token")
    ap.add_argument("--allowed-host", type=hosts_arg, default=os.environ.get("CLAUDECK_ALLOWED_HOSTS", ""),
                    help="extra accepted Host header names, comma-separated (default: $CLAUDECK_ALLOWED_HOSTS)")
    ap.add_argument("--token", default=os.environ.get("CLAUDECK_TOKEN") or None,
                    help="access token when not on loopback (default: $CLAUDECK_TOKEN, else random)")
    ap.add_argument("--no-browser", action="store_true",
                    help="do not open a browser tab (implied on a non-loopback bind)")
    args = ap.parse_args()
    if isinstance(args.allowed_host, str):  # env default bypasses type=
        args.allowed_host = hosts_arg(args.allowed_host)
    ALLOWED_HOSTS.update(args.allowed_host)
    exposed = not ipaddress.IPv4Address(args.bind).is_loopback
    if exposed:
        if args.token is not None and not re.fullmatch(r"[A-Za-z0-9_-]{16,}", args.token):
            ap.error("--token must be at least 16 characters of [A-Za-z0-9_-]")
        TOKEN = args.token or secrets.token_urlsafe(24)
        if not args.allowed_host:
            ALLOWED_HOSTS = None
    srv = ThreadingHTTPServer((args.bind, args.port), Handler)
    url = f"http://localhost:{args.port}/"
    if not exposed:
        print(f"claudeck : {url}  (Ctrl+C to stop)", flush=True)
    else:
        q = f"/?token={TOKEN}"
        print(f"claudeck listening on {args.bind}:{args.port} (token required, Ctrl+C to stop)", flush=True)
        print("Open one of (the token is then kept in a cookie):", flush=True)
        for h in sorted(args.allowed_host):
            print(f"  https://{h}{q}", flush=True)
        for n in _public_names(args.bind):
            print(f"  http://{n}:{args.port}{q}", flush=True)
        print(f"  {url.rstrip('/')}{q}", flush=True)
        if not args.token:
            print("Token generated for this run; set $CLAUDECK_TOKEN to keep it across restarts.", flush=True)
        args.no_browser = True
    if not args.no_browser:
        threading.Timer(0.5, webbrowser.open, [url]).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
